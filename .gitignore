# dependencies
node_modules/
.hub/
.vite/

# git worktrees
/worktrees/

# DSH build output
DSH/apps/*/lib/
DSH/packages/*/lib/
DSH/*/dist/

# stack package build output
plugins/*/*/lib/

# repo .agents/ (docs, hooks, rules, requests, notes) is an ordinary
# tracked directory — do not confuse it with ~/.agents, the user-home
# harness home (runtime state), which is never part of this repo.
# .claude is a local symlink to .agents/ for Claude Code's own session
# state, which lives alongside the tracked docs here but is never itself
# committed.
.agents/RESUME.md
.agents/scheduled_tasks.lock
/.claude

# dsh-tweaks.homeRoot can rehome the harness home root to <repo>/.data
# instead of ~/.agents; its contents are pure runtime state, never
# committed, same treatment as ~/.agents itself.
.data/
.dsh/
.credentials.yaml
accounts.vault

# secrets / browser artifacts
*.vscdb
*cookies*
*.pem

# editor
.DS_Store

# release build output
/.release/

# TypeScript incremental build state. Kept out of git but preserved between
# CI runs by cache, so tsc can skip unchanged projects instead of recompiling
# all 73 packages on every run.
*.tsbuildinfo
