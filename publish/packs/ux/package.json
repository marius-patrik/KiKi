{
  "name": "@dsh-stack/pack-ux",
  "version": "0.3.0",
  "description": "Presentation, editor, terminal, themes and media composition pack.",
  "license": "MIT",
  "type": "module",
  "files": [
    "package.json",
    "stack.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "pack",
    "id": "stack.pack.ux"
  },
  "scripts": {
    "build": "node ../../scripts/../../scripts/pack.mjs build",
    "typecheck": "node ../../scripts/../../scripts/pack.mjs typecheck",
    "test": "node ../../scripts/../../scripts/pack.mjs test",
    "verify": "node ../../scripts/../../scripts/pack.mjs verify"
  },
  "dependencies": {
    "@dsh-stack/icon-engine": "workspace:*",
    "@dsh-stack/lucide-animated": "workspace:*",
    "@dsh-stack/profile-runtime": "workspace:*",
    "@dsh-stack/profile-ui": "workspace:*",
    "@dsh-stack/sidebar-preferences": "workspace:*",
    "@dsh-stack/sidebar-settings": "workspace:*",
    "@dsh-stack/sidebar-shell": "workspace:*",
    "@dsh-stack/skin-claude": "workspace:*",
    "@dsh-stack/skin-codex": "workspace:*",
    "@dsh-stack/skin-deepseek": "workspace:*",
    "@dsh-stack/skin-host": "workspace:*",
    "@dsh-stack/skin-runtime": "workspace:*",
    "@dsh-stack/skin-settings": "workspace:*",
    "@dsh-stack/themes": "workspace:*",
    "@dsh-stack/tui": "workspace:*",
    "@dsh-stack/tweak-drag-drop": "workspace:*",
    "@dsh-stack/tweak-fork-undo": "workspace:*",
    "@dsh-stack/tweak-keybinds": "workspace:*",
    "@dsh-stack/tweak-plan-toggle": "workspace:*",
    "@dsh-stack/tweak-share-links": "workspace:*",
    "@dsh-stack/tweak-slash-commands": "workspace:*",
    "@dsh-stack/tweak-stats": "workspace:*",
    "@dsh-stack/tweaks": "workspace:*",
    "@dsh-stack/voice": "workspace:*",
    "@dsh-stack/workspace-files": "workspace:*"
  }
}
