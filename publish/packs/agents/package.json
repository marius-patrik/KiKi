{
  "name": "@dsh-stack/pack-agents",
  "version": "0.3.0",
  "description": "Composable agent capability pack over the canonical Stack agent plugins.",
  "license": "MIT",
  "type": "module",
  "files": [
    "package.json",
    "stack.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "pack",
    "id": "stack.pack.agents"
  },
  "scripts": {
    "build": "node ../../scripts/../../scripts/pack.mjs build",
    "typecheck": "node ../../scripts/../../scripts/pack.mjs typecheck",
    "test": "node ../../scripts/../../scripts/pack.mjs test",
    "verify": "node ../../scripts/../../scripts/pack.mjs verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@dsh-stack/agent-actions": "workspace:*",
    "@dsh-stack/agent-commands": "workspace:*",
    "@dsh-stack/agent-loops": "workspace:*",
    "@dsh-stack/agent-personas": "workspace:*",
    "@dsh-stack/agent-preset-coding": "workspace:*",
    "@dsh-stack/agent-preset-default": "workspace:*",
    "@dsh-stack/agent-preset-manager": "workspace:*",
    "@dsh-stack/agent-skills": "workspace:*",
    "@dsh-stack/agent-tools": "workspace:*",
    "@dsh-stack/agents": "workspace:*",
    "@dsh-stack/translator": "workspace:*"
  }
}
