{
  "name": "@dsh-stack/pack-bundle",
  "description": "Harness-bootable dsh.bundle wrapper that mounts the complete dsh-stack catalog (every plugin/extension reachable from the ai, core, ux, integrations, agents, trading and vcs packs) into a single profile bundle entry, so a profile loads the whole Stack with one dsh.profile.bundles line instead of manual per-plugin wiring.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "package.json",
    "stack.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "pack",
    "id": "stack.pack.bundle"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/../../scripts/pack.mjs build && node ../../scripts/../../scripts/generate-stack-bundle-patch.mjs write",
    "typecheck": "node ../../scripts/../../scripts/pack.mjs typecheck",
    "test": "node ../../scripts/../../scripts/pack.mjs test",
    "verify": "node ../../scripts/../../scripts/generate-stack-bundle-patch.mjs check && node ../../scripts/../../scripts/pack.mjs verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@dsh-stack/agent-actions": "workspace:*",
    "@dsh-stack/agent-commands": "workspace:*",
    "@dsh-stack/agent-loops": "workspace:*",
    "@dsh-stack/agent-personas": "workspace:*",
    "@dsh-stack/agent-preset-coding": "workspace:*",
    "@dsh-stack/agent-preset-default": "workspace:*",
    "@dsh-stack/agent-skills": "workspace:*",
    "@dsh-stack/agent-tools": "workspace:*",
    "@dsh-stack/agents": "workspace:*",
    "@dsh-stack/composition": "workspace:*",
    "@dsh-stack/credential-vault": "workspace:*",
    "@dsh-stack/dialects": "workspace:*",
    "@dsh-stack/formatters": "workspace:*",
    "@dsh-stack/hosts": "workspace:*",
    "@dsh-stack/icon-engine": "workspace:*",
    "@dsh-stack/lsp": "workspace:*",
    "@dsh-stack/lucide-animated": "workspace:*",
    "@dsh-stack/marketplace": "workspace:*",
    "@dsh-stack/marketplace-source-dsh-stack": "workspace:*",
    "@dsh-stack/profile-runtime": "workspace:*",
    "@dsh-stack/profile-ui": "workspace:*",
    "@dsh-stack/provider-rotation": "workspace:*",
    "@dsh-stack/providers": "workspace:*",
    "@dsh-stack/repos": "workspace:*",
    "@dsh-stack/sidebar-preferences": "workspace:*",
    "@dsh-stack/sidebar-settings": "workspace:*",
    "@dsh-stack/sidebar-shell": "workspace:*",
    "@dsh-stack/skin-claude": "workspace:*",
    "@dsh-stack/skin-codex": "workspace:*",
    "@dsh-stack/skin-deepseek": "workspace:*",
    "@dsh-stack/skin-host": "workspace:*",
    "@dsh-stack/skin-runtime": "workspace:*",
    "@dsh-stack/skin-settings": "workspace:*",
    "@dsh-stack/themes": "workspace:*",
    "@dsh-stack/trading-backtest": "workspace:*",
    "@dsh-stack/trading-market-data": "workspace:*",
    "@dsh-stack/trading-optimizer": "workspace:*",
    "@dsh-stack/trading-research": "workspace:*",
    "@dsh-stack/translator": "workspace:*",
    "@dsh-stack/tui": "workspace:*",
    "@dsh-stack/tweak-drag-drop": "workspace:*",
    "@dsh-stack/tweak-fork-undo": "workspace:*",
    "@dsh-stack/tweak-keybinds": "workspace:*",
    "@dsh-stack/tweak-plan-toggle": "workspace:*",
    "@dsh-stack/tweak-share-links": "workspace:*",
    "@dsh-stack/tweak-slash-commands": "workspace:*",
    "@dsh-stack/tweak-stats": "workspace:*",
    "@dsh-stack/tweaks": "workspace:*",
    "@dsh-stack/voice": "workspace:*",
    "@dsh-stack/workspace-files": "workspace:*"
  }
}
