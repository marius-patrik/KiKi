{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "script",
    "dns-sd",
    "sips",
    "tailscale"
  ],
  "ignore": [
    "DSH/**"
  ],
  "rules": {
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/**/*.test.mjs",
        "scripts/client-runtime/*.js"
      ],
      "project": [
        "scripts/**/*.{mjs,js}"
      ]
    },
    "plugins/*/*": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "client.js",
        "*.mjs",
        "bin/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs",
        "bin/*.mjs"
      ]
    },
    "plugins/ai/providers": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "client.js",
        "*.mjs",
        "bin/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs",
        "bin/*.mjs"
      ],
      "ignoreDependencies": [
        "@dsh-stack/sidebar-preferences"
      ]
    },
    "plugins/ux/skin-claude": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "@types/react"
      ]
    },
    "plugins/ux/skin-codex": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "@types/react"
      ]
    }
  },
  "ignoreDependencies": [
    "@deepseek-ai/dsh-client-ui-slots"
  ]
}
