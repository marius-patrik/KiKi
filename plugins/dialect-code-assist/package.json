{
  "name": "@dsh-stack/dialect-code-assist",
  "version": "0.1.0",
  "description": "Google Code Assist wire dialect extension for the Stack dialects registry.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "package.json",
    "stack.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.ai.dialect.code-assist"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node verify.mjs",
    "test": "node test.mjs"
  },
  "dependencies": {
    "@dsh-stack/dialects": "workspace:*",
    "@dsh-stack/dialect-gemini": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  }
}
