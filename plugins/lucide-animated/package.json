{
  "name": "@dsh-stack/lucide-animated",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "@dsh-stack/icon-engine": "workspace:*",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "stack": {
    "kind": "extension",
    "id": "stack.ui.icons.lucide-animated"
  },
  "publishConfig": {
    "access": "public"
  }
