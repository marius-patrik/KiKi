{
  "name": "@dsh-stack/credential-vault",
  "description": "Encrypted credential vault, account manager, OAuth refresh supervisor, importers and local vault web surface.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "client.js",
    "package.json",
    "stack.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.security.credentials"
  },
  "scripts": {
    "build": "tsc && cat ../../../scripts/client-runtime/crypto-polyfill.js ../../../scripts/client-runtime/glyph-factory.js client.js > lib/client.js",
    "typecheck": "tsc --noEmit",
    "test": "node check-plugin.mjs",
    "verify": "node check-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2"
  }
}
