{
  "name": "@dsh-stack/tweaks",
  "description": "User-facing harness tweaks surface: the tweaks settings namespace registrar and homeRoot/command mirror-to-home. Session-UX features live in the tweak-* extensions.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./home": "./lib/home.js"
  },
  "files": [
    "lib",
    "client.js",
    "client-settings-customization-hub.js",
    "client-settings-segmented-tabs.js",
    "stack.json"
  ],
  "scripts": {
    "build": "tsc && cat ../../../scripts/client-runtime/crypto-polyfill.js ../../../scripts/client-runtime/glyph-factory.js client-settings-segmented-tabs.js client-settings-customization-hub.js client.js > lib/client.js",
    "typecheck": "tsc --noEmit",
    "test": "node check-plugin.mjs && node settings-customization-hub.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@dsh-stack/plugin-kit": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.tweaks"
  },
  "publishConfig": {
    "access": "public"
  }
}
