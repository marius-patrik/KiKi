{
  "name": "@dsh-stack/composition",
  "version": "0.1.0",
  "description": "Stack plugin, pack and profile composition metadata.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.core.composition"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "@dsh-stack/plugin-kit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
