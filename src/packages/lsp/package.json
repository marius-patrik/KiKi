{
  "name": "@dsh-stack/lsp",
  "description": "LSP server configuration + dsh lsp CLI for the DeepSeek Harness LSP capability seam",
  "version": "0.1.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node check-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-lsp": "0.2.0-rc.2",
    "@deepseek-ai/dsh-lsp-stdio": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-lsp": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "dependencies": {
    "@dsh-stack/plugin-kit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-lsp": "0.2.0-rc.2",
    "@deepseek-ai/dsh-lsp-stdio": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-lsp": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.dev.lsp"
  },
  "publishConfig": {
    "access": "public"
  }
}
