{
  "name": "@dsh-stack/voice",
  "description": "Natural, human-sounding voice for the dsh harness: server-proxied neural TTS read-aloud and agent speech tools over OpenAI-compatible endpoints, browser-native or Whisper speech input, and a Voice settings section",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marius-patrik/dsh-voice.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "speech-to-text",
    "text-to-speech",
    "stt",
    "tts",
    "whisper",
    "web-speech-api",
    "read-aloud"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp client.js lib/client.js",
    "typecheck": "tsc --noEmit",
    "test": "node check-plugin.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "connection"
      ],
      "platform": "web",
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@dsh-stack/plugin-kit": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.media.voice"
  },
  "publishConfig": {
    "access": "public"
  }
}
