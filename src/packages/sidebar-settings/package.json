{
  "name": "@dsh-stack/sidebar-settings",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@dsh-stack/sidebar-preferences"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "@dsh-stack/lucide-animated": "workspace:*",
    "@dsh-stack/settings-panel": "workspace:*",
    "@dsh-stack/sidebar-preferences": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.ui.sidebar-settings"
  },
  "publishConfig": {
    "access": "public"
  }
}
