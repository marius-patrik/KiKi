{
  "name": "@dsh-stack/dialects",
  "version": "0.1.0",
  "description": "The provider-wire-dialect abstraction: registers the `ctx.dialects` registry that concrete dialect extensions (`@dsh-stack/dialect-openai`, `-claude`, `-gemini`, `-code-assist`, `-antigravity`) plug into.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test.mjs && node check-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.ai.dialects"
  },
  "publishConfig": {
    "access": "public"
  }
}
